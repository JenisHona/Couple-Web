# MongoDB Connection String
# For local development:
# MONGODB_URI=mongodb://localhost:27017/couples-journal

# For MongoDB Atlas (cloud):
# 1. Go to https://www.mongodb.com/cloud/atlas
# 2. Create a free cluster
# 3. Create a database user
# 4. Get connection string
# 5. Replace <username> and <password> with your credentials
MONGODB_URI=mongodb+srv://username:password@cluster-name.mongodb.net/couples-journal?retryWrites=true&w=majority

# JWT Secret - Change this to a random string in production!
# Generate a random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-key-change-this-in-production

# Optional: For future email/Spotify integrations
# SENDGRID_API_KEY=your_sendgrid_api_key
# SPOTIFY_CLIENT_ID=your_spotify_client_id
# SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
# NEXT_PUBLIC_URL=http://localhost:3000
